    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.0" date="2026-10-03">
      <description translate="no">
        <p>Automations can now be stopped at any point by pressing "F5".</p>
        <p>The app now remembers the previously set values for delay, duration of automation etc.</p>
        <p>Added Japanese (camegone), Italian (Albano Battistella) and Brazilian Portuguese (johnpetersa19) translations.</p>
      </description>
    </release>
    <release version="0.1.8" date="2024-08-01">
      <description translate="no">
        <p>Added translations support and Hindi translation.</p>
      </description>
    </release>
    <release version="0.1.6" date="2024-06-13">
      <description translate="no">
        <p>Added Pattern mode: performs key presses as per the pattern provided by the user. Still in experimental mode and subject to change.</p>
      </description>
    </release>
