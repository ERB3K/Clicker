<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.codelogistics.clicker</id>

  <name>Clicker</name>
  <summary>Simulate user input repeatedly</summary>

  <developer id="net.codelogistics">
  <name translate="no">Satvik Patwardhan</name>
  </developer>

  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Clicker is an auto clicker - it can simulate user input like mouse clicks and key presses repeatedly at given intervals for a given duration.
      This is useful in some video games.
    </p>
    <p>
      Clicker works on both Wayland and X11 by simulating a remote desktop session. The user will need to grant this permission
      each time they start an automation.
    </p>
    <p>
      The automation can be paused at any point by pressing the F5 key, if the user's desktop environment provides support for the Global Shortcuts
      portal and the user grants permission for this hotkey to be registered.
    </p>
  </description>

  <content_rating type="oars-1.0" />
  <url type="homepage">https://gitlab.gnome.org/eyekay/clicker/</url>
  <url type="vcs-browser">https://gitlab.gnome.org/eyekay/clicker/</url>
  <url type="bugtracker">https://gitlab.gnome.org/eyekay/clicker/-/work_items</url>

  <launchable type="desktop-id">net.codelogistics.clicker.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://codelogistics.net/clicker1.png</image>
